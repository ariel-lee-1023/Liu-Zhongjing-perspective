  "independent_source_notes": [
    {
      "id": "KNW-C01",
      "source_id": "KNW26",
      "pages": [
        1,
        2,
        9
      ],
      "independent_argument_or_mechanism": "實作知識包含提出方案、觀察後果、修改及尋找專家；知道操作為何不同並承擔反饋，與僅照命令工作或聽聞新話不同。",
      "necessary_conditions_or_limits": [
        "農場／建房是來源歷史類比，不轉成所有勞動者都不思考的普遍命題。"
      ],
      "what_to_check_in_frozen_draft": "不能只留華盛頓姓名和「知行合一」式總結；需保留可觀察的反饋／修正過程。",
      "possible_runtime_home": "知識與實作",
      "draft_omission_established": false
    },
    {
      "id": "KNW-C02",
      "source_id": "KNW26",
      "pages": [
        2,
        3,
        4
      ],
      "independent_argument_or_mechanism": "同一材料對查證者可以成為知識，對只聽結論的受眾仍可能只是新意識形態；新說法帶來愉悅和優越感，熟悉後又變空虛。",
      "necessary_conditions_or_limits": [
        "新舊內容的政治立場本身不決定聽者是否獲得了可操作知識。"
      ],
      "what_to_check_in_frozen_draft": "不要把「換成劉仲敬觀點」寫成已獲真知；應保留受眾和生產者的不同位置。",
      "possible_runtime_home": "知識與受眾",
      "draft_omission_established": false
    },
    {
      "id": "KNW-C03",
      "source_id": "KNW26",
      "pages": [
        3,
        4,
        5
      ],
      "independent_argument_or_mechanism": "研究可以在既有政治認知框架內繼續發現材料；是否有實際研究工作，與是否超越全部意識形態，是兩個問題。講者也明認會選擇有利於自身政治目的的材料。",
      "necessary_conditions_or_limits": [
        "涉及具名史家、內部說法及動機的段落是來源的設例或評述，未由本輪外核。"
      ],
      "what_to_check_in_frozen_draft": "不能簡化成只有無立場研究者才有知識，也不能把講者放在選擇性取材之外。",
      "possible_runtime_home": "學術／知識生產",
      "draft_omission_established": false
    },
    {
      "id": "KNW-C04",
      "source_id": "KNW26",
      "pages": [
        5,
        6,
        7,
        8
      ],
      "independent_argument_or_mechanism": "同一麻風村材料可被編成反帝成就、人權批評或資源／強制成本三種敘事；軍事動員體系和覆蓋全社會福利的財政需求不同，競爭可偏向較便宜的軍事優先安排。",
      "necessary_conditions_or_limits": [
        "醫療效果、疾病消滅、個案暴力及具名動機皆為來源強斷言；可保存敘事和成本機制，不把它們當已核醫療史。",
        "三種敘事不是相互排除的事實清單；來源承認其他敘事部分觀察成立。"
      ],
      "what_to_check_in_frozen_draft": "若納入此長例，需說清各方如何挑選同一材料，不能只作政權邪惡口號或療法結論。",
      "possible_runtime_home": "國家功能／知識材料",
      "draft_omission_established": false
    },
    {
      "id": "KNW-C05",
      "source_id": "KNW26",
      "pages": [
        8
      ],
      "independent_argument_or_mechanism": "過去封閉、局部的強制組織手段，遇到大城市與國際貿易網絡後，其持續成本及可維持時間會不同；改革開放後不能假定原組織能力完整恢復。",
      "necessary_conditions_or_limits": [
        "這是來源對既往防疫與體制的時點判斷，不是現況預測或量化已驗結果。"
      ],
      "what_to_check_in_frozen_draft": "不要以一次歷史強制成功推出所有尺度和時點都能照辦。",
      "possible_runtime_home": "制度能力與條件",
      "draft_omission_established": false
    },
    {
      "id": "KNW-C06",
      "source_id": "KNW26",
      "pages": [
        9,
        10,
        11,
