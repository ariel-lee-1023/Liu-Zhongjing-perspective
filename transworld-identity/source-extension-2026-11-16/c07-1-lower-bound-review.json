  "changes": [
    {
      "unit": "U01",
      "part": "巴爾幹",
      "before": "「假民族」是在這個自我治理判準下的政治評價",
      "after": "同稱希臘主義，最初指繼承拜占庭的帝國方案，後來卻是小民族國家；舊名稱會遮蔽政治模式的轉換。「假民族」是在這個自我治理判準下的政治評價",
      "source_ids": [
        "NI02"
      ],
      "window": [
        73,
        79
      ],
      "support": "L75–77直接區分同名希臘主義原帝國方案及後來小民族模式，新增的是同名掩蓋層級轉換的具體案例。",
      "net_added_han": 41
    },
    {
      "unit": "U06",
      "part": "中東歐",
      "before": "階級衝突和民族衝突不是互相排斥的兩種解釋。〔NI17〕",
      "after": "階級衝突和民族衝突不是互相排斥的兩種解釋。一八四八年革命的勝負，最後由俄軍介入改寫，法律資格的爭論並不能替匈牙利革命軍補出戰場力量。〔NI17〕",
      "source_ids": [
        "NI17"
      ],
      "window": [
        5992,
        6003
      ],
      "support": "L5996記載俄軍打垮匈牙利革命軍並恢復哈布斯堡控制，新增法律代表爭議如何被外部武力決定的具體轉折，而非重寫原尾段總論。",
      "net_added_han": 42,
      "wording_clarification": "Specify 1848 revolution as the event, not the year of Russian intervention; same NI17 source, no new source reread."
    },
    {
      "unit": "U07",
      "part": "中東",
      "before": "伊拉克與敘利亞各自形成制度後，普通選民和議會政黨可能寧願把稅金用於本地，避免昂貴的境外統一事業。",
      "after": "英法託管後，伊拉克由費薩爾家族的王室統治，敘利亞採共和國體制。兩國各自形成制度後，普通選民和議會政黨可能寧願把稅金用於本地，避免昂貴的境外統一事業。伊拉克國家民主黨便不必否認統一的理想，而以花費太大、暫守現狀為由，阻止民族使命自動變成支出義務。",
      "source_ids": [
        "NI25"
      ],
      "window": [
        9298,
        9308
      ],
      "support": "L9298的王朝／共和制度差異及L9300國家民主黨出於稅金、軍隊和成本維持現狀，補出既成國家的制度與政黨載體。保留後續代際認同、革命外援和軍財集中條件。",
      "net_added_han": 67
    },
    {
      "unit": "U11",
      "part": "中東",
      "before": "媒體共同造出一個可以被支持或反對的政治主體。",
      "after": "媒體共同造出一個可以被支持或反對的政治主體。報導還會使庫德居民反問自己是誰，由外界的承認反過來加強內部認同。",
      "source_ids": [
        "NI22"
      ],
      "window": [
        8034,
