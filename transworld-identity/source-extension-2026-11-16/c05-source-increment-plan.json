  "independent_argument_groups": [
    {
      "id": "EDU26-A01",
      "source_id": "EDU26",
      "source_units": [
        8,
        9,
        24,
        25,
        26
      ],
      "home": "U10",
      "claim": "學校增加指定資訊，卻可能隔絕社會和自然，教育淨效果須扣除被切斷的資訊；知識與價值不是同一功能。",
      "necessary_cases": [
        "鄰居/售貨員知識對照教科書",
        "家庭教會的價值協調與自學職業硬知識"
      ],
      "conditions_and_limits": [
        "保留封閉學校弊病、P9公辦相對較少與P23公立全否定之張力",
        "不把學校老師自我評價當中立判定"
      ],
      "deduplication": "new_independent_mechanism"
    },
    {
      "id": "EDU26-A02",
      "source_id": "EDU26",
      "source_units": [
        4,
        5,
        15,
        16
      ],
      "home": "U10",
      "claim": "職業技能可由資訊包與現場師徒合作取得；大學普及的精英承諾可能使學生脫離原階級卻不能進入新位置。",
      "necessary_cases": [
        "工作場所師徒/同伴切磋",
        "不需為生計發愁者的博雅教育"
      ],
      "conditions_and_limits": [
        "博雅教育的排他定義屬來源規範立場，不是通行大學定義",
        "不照搬細菌/癌細胞比喻",
        "不能以職業教學與職業學校混為一談"
      ],
      "deduplication": "new_independent_mechanism"
    },
    {
      "id": "EDU26-A03",
      "source_id": "EDU26",
      "source_units": [
        11,
        12,
        18,
        19
      ],
      "home": "U10",
      "claim": "共同活動培養信任，真實興趣和使用需求調節語言知識的吸收。",
      "necessary_cases": [
        "板球合作與運動場/教室對比",
        "英劇小說的持續接觸"
      ],
      "conditions_and_limits": [
        "龍舟俱樂部經歷屬提問者，不作講述者經歷",
        "沒有需要的硬學有限，不推出任何人不必學語言"
      ],
      "deduplication": "new_independent_mechanism"
    },
    {
      "id": "EDU26-A04",
      "source_id": "EDU26",
      "source_units": [
        21,
        22,
        23
      ],
      "home": "U10",
      "claim": "教育券保留普遍供給前提但增加家庭選擇；左右標籤會隨比較背景移動。",
      "necessary_cases": [
        "教育券與官僚供給的差異"
      ],
      "conditions_and_limits": [
        "保留對公立教育能否改好的高度懷疑和所有好教育皆私立的強主張",
        "與CA-X01國家義務教育正面功能並列，不用未知日期排序或弱化原文"
      ],
      "deduplication": "new_independent_mechanism"
    },
    {
      "id": "EDU26-A05",
      "source_id": "EDU26",
      "source_units": [
        28,
        29
      ],
      "home": "U10",
      "claim": "教育者須修正自己的預設，不能把塑造能力想成園丁創造植物本身。",
      "necessary_cases": [
        "原先不想培養的花草",
        "毛毛蟲與蝴蝶"
      ],
      "conditions_and_limits": [
        "容易剪掉可能性不代表能造出預期成果",
        "不得為可塑性預設無限上限"
      ],
      "deduplication": "new_independent_mechanism"
    },
    {
      "id": "ENT26-A01",
      "source_id": "ENT26",
      "source_units": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "home": "U05",
      "claim": "單一興奮點的反覆刺激可窄化感受；生活需應變程度不同，形成不同娛樂需求，主動活動與現成刺激有不同回饋。",
      "necessary_cases": [
        "都市娛樂與面包競技",
